# Copy to .env and fill in values. Never commit real credentials.
# PostgreSQL (preferred):
# DATABASE_URL=postgresql+psycopg2://arogyaconnect:arogyaconnect@localhost:5432/arogyaconnect
# SQLite (local prototype without PostgreSQL):
DATABASE_URL=sqlite:///./arogyaconnect.db

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_PASSWORD=Demo@2026
