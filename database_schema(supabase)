create table public.asha_workers (
  id uuid not null default gen_random_uuid (),
  full_name text null,
  government_id text null,
  phone text null,
  assigned_subcenter text null,
  is_verified boolean null default false,
  created_at timestamp with time zone null default now(),
  constraint asha_workers_pkey primary key (id),
  constraint asha_workers_government_id_key unique (government_id),
  constraint asha_workers_phone_key unique (phone)
) TABLESPACE pg_default;
create table public.doctors (
  id uuid not null default gen_random_uuid (),
  full_name text null,
  specialty text null,
  council_reg_no text null,
  phone text null,
  email text null,
  certificate_url text null,
  has_clinic boolean null default false,
  clinic_details text null,
  is_volunteer boolean null default false,
  volunteer_radius text null,
  has_legal_history boolean null default false,
  legal_explanation text null,
  password text null,
  is_verified boolean null default false,
  created_at timestamp with time zone null default now(),
  constraint doctors_pkey primary key (id),
  constraint doctors_council_reg_no_key unique (council_reg_no),
  constraint doctors_phone_key unique (phone)
) TABLESPACE pg_default;
create table public.patients (
  id uuid not null default gen_random_uuid (),
  name text null,
  phone text null,
  email text null,
  password text null,
  age integer null,
  gender text null,
  village text null,
  blood_group text null,
  known_conditions text null,
  is_otp_verified boolean null default false,
  created_at timestamp with time zone null default now(),
  constraint patients_pkey primary key (id),
  constraint patients_phone_key unique (phone)
) TABLESPACE pg_default;
create table public.triage_cases (
  id uuid not null default gen_random_uuid (),
  patient_id uuid null,
  asha_id uuid null,
  doctor_id uuid null,
  age integer null,
  gender text null,
  symptoms text null,
  symptom_duration text null,
  temperature numeric null,
  spo2 numeric null,
  heart_rate integer null,
  blood_pressure text null,
  respiratory_rate integer null,
  ai_triage_level text null,
  ai_urgency text null,
  ai_recommended_action text null,
  doctor_decision text null,
  doctor_notes text null,
  status text null default 'Pending'::text,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  ai_followup_answers jsonb null,
  constraint triage_cases_pkey primary key (id),
  constraint triage_cases_asha_id_fkey foreign KEY (asha_id) references asha_workers (id),
  constraint triage_cases_doctor_id_fkey foreign KEY (doctor_id) references doctors (id),
  constraint triage_cases_patient_id_fkey foreign KEY (patient_id) references patients (id)
) TABLESPACE pg_default;
